generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                        String                     @id @default(cuid())
  username                  String                     @unique @db.VarChar(100)
  email                     String                     @unique @db.VarChar(255)
  passwordHash              String                     @map("password_hash") @db.VarChar(255)
  isActive                  Boolean                    @default(true) @map("is_active")
  sessionVersion            Int                        @default(0) @map("session_version")
  mfaEnabled                Boolean                    @default(false) @map("mfa_enabled")
  mfaSecret                 String?                    @map("mfa_secret") @db.VarChar(255)
  createdAt                 DateTime                   @default(now()) @map("created_at")
  updatedAt                 DateTime                   @updatedAt @map("updated_at")
  roles                     UserRole[]
  refreshTokens             RefreshToken[]
  notifications             Notification[]
  uploadedAttachments       Attachment[]               @relation("AttachmentUploader")
  attachmentAccessLogs      AttachmentAccessLog[]      @relation("AttachmentAccessActor")
  requestedApprovals        ApprovalRequest[]          @relation("ApprovalRequester")
  decidedApprovals          ApprovalRequest[]          @relation("ApprovalDecider")
  auditEvents               AuditEvent[]               @relation("AuditActor")
  journalEntries            JournalEntry[]
  customers                 Customer[]                 @relation("CustomerOwner")
  vehicles                  Vehicle[]                  @relation("VehicleOwner")
  leads                     Lead[]                     @relation("LeadOwner")
  bookings                  Booking[]                  @relation("BookingOwner")
  salesLeadActivities       SalesLeadActivity[]        @relation("SalesActivityCreator")
  bookingStatusChanges      BookingStatusHistory[]     @relation("BookingStatusChanger")
  bookingRequests           BookingRequest[]           @relation("BookingRequestRequester")
  decidedBookingRequests    BookingRequest[]           @relation("BookingRequestApprover")
  salesInvoices             SalesInvoice[]             @relation("SalesInvoiceCreator")
  salesPayments             SalesPayment[]             @relation("SalesPaymentCreator")
  salesDeliveries           SalesDelivery[]            @relation("SalesDeliveryCreator")
  bookingDocuments          BookingDocument[]          @relation("BookingDocumentCreator")
  technicianAssignments     TechnicianAssignment[]     @relation("TechnicianAssignments")
  laborOperations           LaborOperation[]           @relation("LaborTechnician")
  approvedEstimates         Estimate[]                 @relation("EstimateApprover")
  inspections               Inspection[]               @relation("InspectionInspector")
  jobCards                  JobCard[]
  bodyPaintOrders           BodyPaintRepairOrder[]     @relation("BodyPaintCreator")
  bodyPaintAssessments      DamageAssessment[]         @relation("DamageAssessor")
  bodyPaintOperations       BodyPaintOperation[]       @relation("BodyPaintTechnician")
  bodyPaintFinalInspections BodyPaintFinalInspection[] @relation("BodyPaintFinalInspector")
  vehicleMovements          VehicleMovement[]          @relation("MovementActor")
  approvedExpenses          Expense[]                  @relation("ExpenseApprover")
  postedExpenses            Expense[]                  @relation("ExpensePoster")
  createdFinanceDocuments   FinanceDocument[]          @relation("FinanceDocumentCreator")
  bankTransactions          BankTransaction[]          @relation("BankTransactionCreator")
  reconciliations           Reconciliation[]           @relation("ReconciliationCreator")
  fiscalPeriodClosures      FiscalPeriodCloseControl[] @relation("FiscalPeriodCloser")
  closedFiscalPeriods       FiscalPeriod[]             @relation("FiscalPeriodCloserPeriod")
  cashierSessions           CashierSession[]           @relation("CashierUserSessions")
  cashierTransactions       CashierTransaction[]       @relation("CashierTransactionActor")
  approvedCashierReversals  CashierTransaction[]       @relation("CashierReversalApprover")
  cashierReceipts           CashierReceipt[]           @relation("CashierReceiptCreator")
  paymentVouchers           PaymentVoucher[]           @relation("PaymentVoucherCreator")
  cashierClosings           DailyCashierClosing[]      @relation("CashierClosingCreator")

  @@map("users")
}

model RefreshToken {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  revokedAt  DateTime? @map("revoked_at")
  replacedBy String?   @map("replaced_by") @db.VarChar(191)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("refresh_tokens")
}

model NumberSequence {
  id        String   @id @default(cuid())
  key       String   @unique @db.VarChar(80)
  prefix    String   @db.VarChar(30)
  nextValue Int      @default(1) @map("next_value")
  padding   Int      @default(4)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("number_sequences")
}

enum ApprovalRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model Notification {
  id          String    @id @default(cuid())
  recipientId String    @map("recipient_id")
  type        String    @db.VarChar(80)
  title       String    @db.VarChar(160)
  message     String    @db.VarChar(1000)
  entityType  String?   @map("entity_type") @db.VarChar(80)
  entityId    String?   @map("entity_id") @db.VarChar(100)
  readAt      DateTime? @map("read_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  recipient   User      @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, readAt, createdAt])
  @@map("notifications")
}

model Attachment {
  id           String                @id @default(cuid())
  entityType   String                @map("entity_type") @db.VarChar(80)
  entityId     String                @map("entity_id") @db.VarChar(100)
  fileName     String                @map("file_name") @db.VarChar(255)
  storageKey   String                @map("storage_key") @db.VarChar(500)
  contentType  String                @map("content_type") @db.VarChar(160)
  sizeBytes    Int                   @map("size_bytes")
  checksum     String                @db.Char(64)
  uploadedById String                @map("uploaded_by_id")
  createdAt    DateTime              @default(now()) @map("created_at")
  uploadedBy   User                  @relation("AttachmentUploader", fields: [uploadedById], references: [id])
  accessLogs   AttachmentAccessLog[]

  @@index([entityType, entityId, createdAt])
  @@map("attachments")
}

model AttachmentAccessLog {
  id           String     @id @default(cuid())
  attachmentId String     @map("attachment_id")
  actorId      String     @map("actor_id")
  action       String     @db.VarChar(40)
  createdAt    DateTime   @default(now()) @map("created_at")
  attachment   Attachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
  actor        User       @relation("AttachmentAccessActor", fields: [actorId], references: [id])

  @@index([attachmentId, createdAt])
  @@map("attachment_access_logs")
}

model ApprovalRequest {
  id          String                @id @default(cuid())
  workflow    String                @db.VarChar(100)
  entityType  String                @map("entity_type") @db.VarChar(80)
  entityId    String                @map("entity_id") @db.VarChar(100)
  requesterId String                @map("requester_id")
  approverId  String?               @map("approver_id")
  status      ApprovalRequestStatus @default(PENDING)
  reason      String?               @db.VarChar(1000)
  decision    String?               @db.VarChar(1000)
  createdAt   DateTime              @default(now()) @map("created_at")
  decidedAt   DateTime?             @map("decided_at")
  requester   User                  @relation("ApprovalRequester", fields: [requesterId], references: [id])
  approver    User?                 @relation("ApprovalDecider", fields: [approverId], references: [id])

  @@index([workflow, entityType, entityId, status])
  @@map("approval_requests")
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique @db.VarChar(100)
  description String?          @db.VarChar(255)
  userRoles   UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(cuid())
  code        String           @unique @db.VarChar(120)
  description String?          @db.VarChar(255)
  roles       RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId String @map("user_id")
  roleId String @map("role_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Department {
  id        String   @id @default(cuid())
  code      String   @unique @db.VarChar(30)
  name      String   @db.VarChar(120)
  createdAt DateTime @default(now()) @map("created_at")
  branches  Branch[]

  @@map("departments")
}

model Branch {
  id              String                 @id @default(cuid())
  code            String                 @unique @db.VarChar(30)
  name            String                 @db.VarChar(120)
  departmentId    String?                @map("department_id")
  department      Department?            @relation(fields: [departmentId], references: [id])
  locations       Location[]
  customers       Customer[]
  vehicles        Vehicle[]
  leads           Lead[]
  bookings        Booking[]
  jobCards        JobCard[]
  bodyPaintOrders BodyPaintRepairOrder[]
  cashierSessions CashierSession[]
  cashierClosings DailyCashierClosing[]

  @@map("branches")
}

model Location {
  id            String             @id @default(cuid())
  branchId      String             @map("branch_id")
  code          String             @db.VarChar(30)
  name          String             @db.VarChar(120)
  branch        Branch             @relation(fields: [branchId], references: [id])
  balances      StockBalance[]
  transactions  StockTransaction[]
  goodsReceipts GoodsReceipt[]
  partsIssues   PartsIssue[]
  partsReturns  PartsReturn[]
  movementsFrom VehicleMovement[]  @relation("MovementFrom")
  movementsTo   VehicleMovement[]  @relation("MovementTo")

  @@unique([branchId, code])
  @@map("locations")
}

model AuditEvent {
  id         String   @id @default(cuid())
  actorId    String?  @map("actor_id")
  action     String   @db.VarChar(80)
  entityType String   @map("entity_type") @db.VarChar(80)
  entityId   String?  @map("entity_id") @db.VarChar(100)
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_events")
}

model Customer {
  id                    String                 @id @default(cuid())
  branchId              String                 @map("branch_id")
  ownerId               String?                @map("owner_id")
  name                  String                 @db.VarChar(160)
  phone                 String                 @db.VarChar(40)
  email                 String?                @db.VarChar(255)
  address               String?                @db.VarChar(255)
  cnicHash              String?                @map("cnic_hash") @db.Char(64)
  sourceType            String?                @map("source_type") @db.VarChar(80)
  sourceId              String?                @map("source_id") @db.VarChar(120)
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  branch                Branch                 @relation(fields: [branchId], references: [id])
  owner                 User?                  @relation("CustomerOwner", fields: [ownerId], references: [id])
  vehicles              Vehicle[]
  leads                 Lead[]
  bookings              Booking[]
  jobCards              JobCard[]
  bodyPaintRepairOrders BodyPaintRepairOrder[]
  receivables           Receivable[]
  cashierReceipts       CashierReceipt[]

  @@index([branchId, createdAt])
  @@index([branchId, phone])
  @@map("customers")
}

model Vehicle {
  id              String                 @id @default(cuid())
  branchId        String                 @map("branch_id")
  ownerId         String?                @map("owner_id")
  customerId      String?                @map("customer_id")
  registrationNo  String                 @map("registration_no") @db.VarChar(40)
  vin             String?                @db.VarChar(80)
  make            String                 @db.VarChar(80)
  model           String                 @db.VarChar(80)
  modelYear       Int?                   @map("model_year")
  color           String?                @db.VarChar(40)
  sourceType      String?                @map("source_type") @db.VarChar(80)
  sourceId        String?                @map("source_id") @db.VarChar(120)
  salePrice       Decimal?               @map("sale_price") @db.Decimal(18, 4)
  availability    VehicleAvailability    @default(AVAILABLE)
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")
  branch          Branch                 @relation(fields: [branchId], references: [id])
  owner           User?                  @relation("VehicleOwner", fields: [ownerId], references: [id])
  customer        Customer?              @relation(fields: [customerId], references: [id])
  bookings        Booking[]
  jobCards        JobCard[]
  bodyPaintOrders BodyPaintRepairOrder[]

  @@unique([branchId, registrationNo])
  @@index([branchId, vin])
  @@map("vehicles")
}

model Lead {
  id         String              @id @default(cuid())
  branchId   String              @map("branch_id")
  ownerId    String?             @map("owner_id")
  customerId String?             @map("customer_id")
  name       String              @db.VarChar(160)
  phone      String              @db.VarChar(40)
  email      String?             @db.VarChar(255)
  interest   String?             @db.VarChar(160)
  status     LeadStatus          @default(NEW)
  sourceType String?             @map("source_type") @db.VarChar(80)
  sourceId   String?             @map("source_id") @db.VarChar(120)
  createdAt  DateTime            @default(now()) @map("created_at")
  updatedAt  DateTime            @updatedAt @map("updated_at")
  branch     Branch              @relation(fields: [branchId], references: [id])
  owner      User?               @relation("LeadOwner", fields: [ownerId], references: [id])
  customer   Customer?           @relation(fields: [customerId], references: [id])
  bookings   Booking[]
  activities SalesLeadActivity[]

  @@index([branchId, status, createdAt])
  @@map("leads")
}

model Booking {
  id               String                  @id @default(cuid())
  branchId         String                  @map("branch_id")
  ownerId          String?                 @map("owner_id")
  customerId       String?                 @map("customer_id")
  vehicleId        String?                 @map("vehicle_id")
  leadId           String?                 @map("lead_id")
  bookingNo        String                  @map("booking_no") @db.VarChar(50)
  bookingDate      DateTime                @map("booking_date")
  status           BookingStatus           @default(RESERVED)
  totalAmount      Decimal                 @default(0) @map("total_amount") @db.Decimal(18, 4)
  discountAmount   Decimal                 @default(0) @map("discount_amount") @db.Decimal(18, 4)
  approvalStatus   BookingApprovalStatus   @default(NOT_REQUIRED) @map("approval_status")
  allocationStatus BookingAllocationStatus @default(UNALLOCATED) @map("allocation_status")
  notes            String?                 @db.VarChar(500)
  sourceType       String?                 @map("source_type") @db.VarChar(80)
  sourceId         String?                 @map("source_id") @db.VarChar(120)
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")
  branch           Branch                  @relation(fields: [branchId], references: [id])
  owner            User?                   @relation("BookingOwner", fields: [ownerId], references: [id])
  customer         Customer?               @relation(fields: [customerId], references: [id])
  vehicle          Vehicle?                @relation(fields: [vehicleId], references: [id])
  lead             Lead?                   @relation(fields: [leadId], references: [id])
  statusHistory    BookingStatusHistory[]
  documents        BookingDocument[]
  paymentSchedules PaymentSchedule[]
  invoices         SalesInvoice[]
  payments         SalesPayment[]
  deliveries       SalesDelivery[]
  requests         BookingRequest[]

  @@unique([branchId, bookingNo])
  @@index([branchId, status, bookingDate])
  @@map("bookings")
}

model ChartOfAccount {
  id               String            @id @default(cuid())
  code             String            @unique @db.VarChar(30)
  name             String            @db.VarChar(150)
  type             AccountType
  parentId         String?           @map("parent_id")
  isActive         Boolean           @default(true) @map("is_active")
  parent           ChartOfAccount?   @relation("AccountTree", fields: [parentId], references: [id])
  children         ChartOfAccount[]  @relation("AccountTree")
  journalLines     JournalLine[]
  expenses         Expense[]
  bankTransactions BankTransaction[]
  reconciliations  Reconciliation[]

  @@map("chart_of_accounts")
}

model FiscalPeriod {
  id             String                    @id @default(cuid())
  name           String                    @db.VarChar(80)
  startsOn       DateTime                  @map("starts_on") @db.Date
  endsOn         DateTime                  @map("ends_on") @db.Date
  status         FiscalPeriodStatus        @default(OPEN)
  closedAt       DateTime?                 @map("closed_at")
  closedById     String?                   @map("closed_by_id")
  journalEntries JournalEntry[]
  closeControl   FiscalPeriodCloseControl?
  closedBy       User?                     @relation("FiscalPeriodCloserPeriod", fields: [closedById], references: [id])

  @@unique([startsOn, endsOn])
  @@map("fiscal_periods")
}

model JournalEntry {
  id              String             @id @default(cuid())
  fiscalPeriodId  String             @map("fiscal_period_id")
  entryDate       DateTime           @map("entry_date") @db.Date
  description     String             @db.VarChar(255)
  sourceType      String?            @map("source_type") @db.VarChar(80)
  sourceId        String?            @map("source_id") @db.VarChar(120)
  status          JournalEntryStatus @default(DRAFT)
  postedAt        DateTime?          @map("posted_at")
  createdAt       DateTime           @default(now()) @map("created_at")
  createdById     String?            @map("created_by_id")
  reversalOfId    String?            @map("reversal_of_id")
  fiscalPeriod    FiscalPeriod       @relation(fields: [fiscalPeriodId], references: [id])
  createdBy       User?              @relation(fields: [createdById], references: [id])
  lines           JournalLine[]
  reversalOf      JournalEntry?      @relation("JournalReversals", fields: [reversalOfId], references: [id])
  reversals       JournalEntry[]     @relation("JournalReversals")
  financeDocument FinanceDocument?

  @@index([entryDate])
  @@index([sourceType, sourceId])
  @@map("journal_entries")
}

model JournalLine {
  id             String         @id @default(cuid())
  journalEntryId String         @map("journal_entry_id")
  accountId      String         @map("account_id")
  debit          Decimal        @default(0) @db.Decimal(18, 4)
  credit         Decimal        @default(0) @db.Decimal(18, 4)
  description    String?        @db.VarChar(255)
  journalEntry   JournalEntry   @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account        ChartOfAccount @relation(fields: [accountId], references: [id])

  @@index([accountId])
  @@map("journal_lines")
}

model StockBalance {
  id             String   @id @default(cuid())
  locationId     String   @map("location_id")
  itemCode       String   @map("item_code") @db.VarChar(80)
  quantity       Decimal  @default(0) @db.Decimal(18, 4)
  averageCost    Decimal  @default(0) @map("average_cost") @db.Decimal(18, 4)
  inventoryValue Decimal  @default(0) @map("inventory_value") @db.Decimal(18, 4)
  updatedAt      DateTime @updatedAt @map("updated_at")
  location       Location @relation(fields: [locationId], references: [id])

  @@unique([locationId, itemCode])
  @@map("stock_balances")
}

model StockTransaction {
  id         String               @id @default(cuid())
  locationId String               @map("location_id")
  itemCode   String               @map("item_code") @db.VarChar(80)
  type       StockTransactionType
  quantity   Decimal              @db.Decimal(18, 4)
  unitCost   Decimal?             @map("unit_cost") @db.Decimal(18, 4)
  totalCost  Decimal?             @map("total_cost") @db.Decimal(18, 4)
  reference  String?              @db.VarChar(120)
  createdAt  DateTime             @default(now()) @map("created_at")
  location   Location             @relation(fields: [locationId], references: [id])

  @@index([locationId, itemCode, createdAt])
  @@map("stock_transactions")
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum FiscalPeriodStatus {
  OPEN
  CLOSED
}

enum JournalEntryStatus {
  DRAFT
  POSTED
  REVERSED
}

enum StockTransactionType {
  RECEIPT
  ISSUE
  RETURN
  TRANSFER
  ADJUSTMENT
}

model PartCategory {
  id        String   @id @default(cuid())
  code      String   @unique @db.VarChar(50)
  name      String   @db.VarChar(120)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  parts     Part[]

  @@index([name])
  @@map("part_categories")
}

model Part {
  id                 String                @id @default(cuid())
  code               String                @unique @db.VarChar(80)
  name               String                @db.VarChar(160)
  description        String?               @db.VarChar(500)
  categoryId         String?               @map("category_id")
  unit               String                @default("EA") @db.VarChar(20)
  reorderLevel       Decimal               @default(0) @map("reorder_level") @db.Decimal(18, 4)
  maxStockLevel      Decimal               @default(0) @map("max_stock_level") @db.Decimal(18, 4)
  isActive           Boolean               @default(true) @map("is_active")
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")
  purchaseLines      PurchaseOrderLine[]
  receiptLines       GoodsReceiptLine[]
  requestLines       PartsRequestLine[]
  estimateLines      EstimateLine[]
  issueLines         PartsIssueLine[]
  returnLines        PartsReturnLine[]
  bodyPaintMaterials MaterialConsumption[]
  category           PartCategory?         @relation(fields: [categoryId], references: [id])

  @@index([name])
  @@map("parts")
}

model Supplier {
  id        String          @id @default(cuid())
  code      String          @unique @db.VarChar(50)
  name      String          @db.VarChar(160)
  phone     String?         @db.VarChar(40)
  email     String?         @db.VarChar(255)
  address   String?         @db.VarChar(255)
  isActive  Boolean         @default(true) @map("is_active")
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")
  orders    PurchaseOrder[]
  payables  Payable[]

  @@index([name])
  @@map("suppliers")
}

model PurchaseOrder {
  id         String              @id @default(cuid())
  orderNo    String              @unique @map("order_no") @db.VarChar(50)
  supplierId String              @map("supplier_id")
  status     PurchaseOrderStatus @default(DRAFT)
  orderedAt  DateTime            @default(now()) @map("ordered_at")
  notes      String?             @db.VarChar(500)
  supplier   Supplier            @relation(fields: [supplierId], references: [id])
  lines      PurchaseOrderLine[]
  receipts   GoodsReceipt[]

  @@index([supplierId, status])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id               String        @id @default(cuid())
  purchaseOrderId  String        @map("purchase_order_id")
  partId           String        @map("part_id")
  quantity         Decimal       @db.Decimal(18, 4)
  receivedQuantity Decimal       @default(0) @map("received_quantity") @db.Decimal(18, 4)
  unitCost         Decimal?      @map("unit_cost") @db.Decimal(18, 4)
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  part             Part          @relation(fields: [partId], references: [id])

  @@unique([purchaseOrderId, partId])
  @@map("purchase_order_lines")
}

model GoodsReceipt {
  id              String             @id @default(cuid())
  receiptNo       String             @unique @map("receipt_no") @db.VarChar(50)
  purchaseOrderId String?            @map("purchase_order_id")
  locationId      String             @map("location_id")
  receivedAt      DateTime           @default(now()) @map("received_at")
  receivedById    String?            @map("received_by_id")
  purchaseOrder   PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id])
  location        Location           @relation(fields: [locationId], references: [id])
  lines           GoodsReceiptLine[]

  @@index([locationId, receivedAt])
  @@map("goods_receipts")
}

model GoodsReceiptLine {
  id             String       @id @default(cuid())
  goodsReceiptId String       @map("goods_receipt_id")
  partId         String       @map("part_id")
  quantity       Decimal      @db.Decimal(18, 4)
  unitCost       Decimal?     @map("unit_cost") @db.Decimal(18, 4)
  goodsReceipt   GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  part           Part         @relation(fields: [partId], references: [id])

