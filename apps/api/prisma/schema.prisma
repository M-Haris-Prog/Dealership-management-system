  notes          String?              @db.VarChar(500)
  repairOrder    BodyPaintRepairOrder @relation(fields: [repairOrderId], references: [id], onDelete: Cascade)
  fromLocation   Location?            @relation("MovementFrom", fields: [fromLocationId], references: [id])
  toLocation     Location?            @relation("MovementTo", fields: [toLocationId], references: [id])
  movedBy        User?                @relation("MovementActor", fields: [movedById], references: [id])

  @@index([repairOrderId, movedAt])
  @@map("body_paint_vehicle_movements")
}

model MaterialConsumption {
  id            String               @id @default(cuid())
  repairOrderId String               @map("repair_order_id")
  partId        String               @map("part_id")
  operationId   String?              @map("operation_id")
  quantity      Decimal              @db.Decimal(18, 4)
  unitCost      Decimal              @default(0) @map("unit_cost") @db.Decimal(18, 4)
  consumedAt    DateTime             @default(now()) @map("consumed_at")
  repairOrder   BodyPaintRepairOrder @relation(fields: [repairOrderId], references: [id], onDelete: Cascade)
  part          Part                 @relation(fields: [partId], references: [id])
  operation     BodyPaintOperation?  @relation(fields: [operationId], references: [id])

  @@index([repairOrderId, consumedAt])
  @@map("body_paint_material_consumptions")
}

model InvoiceReadySummary {
  id             String               @id @default(cuid())
  repairOrderId  String               @unique @map("repair_order_id")
  laborTotal     Decimal              @default(0) @map("labor_total") @db.Decimal(18, 4)
  materialsTotal Decimal              @default(0) @map("materials_total") @db.Decimal(18, 4)
  otherTotal     Decimal              @default(0) @map("other_total") @db.Decimal(18, 4)
  subtotal       Decimal              @db.Decimal(18, 4)
  tax            Decimal              @default(0) @db.Decimal(18, 4)
  total          Decimal              @db.Decimal(18, 4)
  generatedAt    DateTime             @default(now()) @map("generated_at")
  repairOrder    BodyPaintRepairOrder @relation(fields: [repairOrderId], references: [id], onDelete: Cascade)

  @@map("body_paint_invoice_ready_summaries")
}

model BodyPaintInvoice {
  id              String                 @id @default(cuid())
  repairOrderId   String                 @map("repair_order_id")
  invoiceNo       String                 @unique @map("invoice_no") @db.VarChar(60)
  status          BodyPaintInvoiceStatus @default(READY)
  laborTotal      Decimal                @default(0) @map("labor_total") @db.Decimal(18, 4)
  materialsTotal  Decimal                @default(0) @map("materials_total") @db.Decimal(18, 4)
  subtotal        Decimal                @db.Decimal(18, 4)
  tax             Decimal                @default(0) @db.Decimal(18, 4)
  total           Decimal                @db.Decimal(18, 4)
  insurerPayable  Decimal                @default(0) @map("insurer_payable") @db.Decimal(18, 4)
  customerPayable Decimal                @default(0) @map("customer_payable") @db.Decimal(18, 4)
  journalEntryId  String?                @map("journal_entry_id")
  createdById     String?                @map("created_by_id")
  createdAt       DateTime               @default(now()) @map("created_at")
  postedAt        DateTime?              @map("posted_at")
  repairOrder     BodyPaintRepairOrder   @relation(fields: [repairOrderId], references: [id], onDelete: Cascade)

  @@index([repairOrderId, status])
  @@map("body_paint_invoices")
}

model BodyPaintFinalInspection {
  id            String               @id @default(cuid())
  repairOrderId String               @map("repair_order_id")
  passed        Boolean
  checklist     Json
  notes         String?              @db.VarChar(1000)
  inspectorId   String               @map("inspector_id")
  inspectedAt   DateTime             @default(now()) @map("inspected_at")
  repairOrder   BodyPaintRepairOrder @relation(fields: [repairOrderId], references: [id], onDelete: Cascade)
  inspector     User                 @relation("BodyPaintFinalInspector", fields: [inspectorId], references: [id])

  @@index([repairOrderId, inspectedAt])
  @@map("body_paint_final_inspections")
}

enum FinanceDocumentType {
  RECEIVABLE
  PAYABLE
  EXPENSE
  BANK_TRANSACTION
}

enum BodyPaintInvoiceStatus {
  READY
  POSTED
  PAID
}

enum ReceivableStatus {
  OPEN
  PARTIALLY_PAID
  PAID
  VOID
}

enum PayableStatus {
  OPEN
  PARTIALLY_PAID
  PAID
  VOID
}

enum ExpenseStatus {
  DRAFT
  APPROVED
  POSTED
  REJECTED
  VOID
}

enum BankTransactionType {
  RECEIPT
  PAYMENT
  TRANSFER
  FEE
  ADJUSTMENT
}

enum BankTransactionStatus {
  ENTERED
  RECONCILED
  VOID
}

enum ReconciliationStatus {
  OPEN
  COMPLETED
}

model FinanceDocument {
  id              String              @id @default(cuid())
  documentNo      String              @unique @map("document_no") @db.VarChar(60)
  type            FinanceDocumentType
  sourceType      String?             @map("source_type") @db.VarChar(80)
  sourceId        String?             @map("source_id") @db.VarChar(120)
  amount          Decimal             @db.Decimal(18, 4)
  journalEntryId  String?             @unique @map("journal_entry_id")
  createdById     String?             @map("created_by_id")
  createdAt       DateTime            @default(now()) @map("created_at")
  createdBy       User?               @relation("FinanceDocumentCreator", fields: [createdById], references: [id])
  journalEntry    JournalEntry?       @relation(fields: [journalEntryId], references: [id])
  receivable      Receivable?
  payable         Payable?
  expense         Expense?
  bankTransaction BankTransaction?
  salesInvoice    SalesInvoice?
  serviceInvoice  ServiceInvoice?

  @@index([sourceType, sourceId])
  @@map("finance_documents")
}

model Receivable {
  id          String           @id @default(cuid())
  documentId  String           @unique @map("document_id")
  customerId  String?          @map("customer_id")
  dueDate     DateTime         @map("due_date") @db.Date
  amount      Decimal          @db.Decimal(18, 4)
  outstanding Decimal          @db.Decimal(18, 4)
  status      ReceivableStatus @default(OPEN)
  document    FinanceDocument  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  customer    Customer?        @relation(fields: [customerId], references: [id])

  @@index([dueDate])
  @@map("receivables")
}

model Payable {
  id          String          @id @default(cuid())
  documentId  String          @unique @map("document_id")
  supplierId  String?         @map("supplier_id")
  dueDate     DateTime        @map("due_date") @db.Date
  amount      Decimal         @db.Decimal(18, 4)
  outstanding Decimal         @db.Decimal(18, 4)
  status      PayableStatus   @default(OPEN)
  document    FinanceDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  supplier    Supplier?       @relation(fields: [supplierId], references: [id])

  @@index([dueDate])
  @@map("payables")
}

model Expense {
  id               String          @id @default(cuid())
  documentId       String          @unique @map("document_id")
  expenseDate      DateTime        @map("expense_date") @db.Date
  description      String          @db.VarChar(255)
  amount           Decimal         @db.Decimal(18, 4)
  expenseAccountId String          @map("expense_account_id")
  status           ExpenseStatus   @default(DRAFT)
  approvedById     String?         @map("approved_by_id")
  postedById       String?         @map("posted_by_id")
  document         FinanceDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  expenseAccount   ChartOfAccount  @relation(fields: [expenseAccountId], references: [id])
  approvedBy       User?           @relation("ExpenseApprover", fields: [approvedById], references: [id])
  postedBy         User?           @relation("ExpensePoster", fields: [postedById], references: [id])

  @@index([expenseDate])
  @@map("expenses")
}

model BankTransaction {
  id                  String                @id @default(cuid())
  documentId          String                @unique @map("document_id")
  accountId           String                @map("account_id")
  transactionDate     DateTime              @map("transaction_date") @db.Date
  type                BankTransactionType
  amount              Decimal               @db.Decimal(18, 4)
  reference           String?               @db.VarChar(120)
  status              BankTransactionStatus @default(ENTERED)
  createdById         String?               @map("created_by_id")
  document            FinanceDocument       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  account             ChartOfAccount        @relation(fields: [accountId], references: [id])
  createdBy           User?                 @relation("BankTransactionCreator", fields: [createdById], references: [id])
  reconciliationLines ReconciliationLine[]

  @@index([accountId, transactionDate])
  @@map("bank_transactions")
}

model Reconciliation {
  id               String               @id @default(cuid())
  accountId        String               @map("account_id")
  statementDate    DateTime             @map("statement_date") @db.Date
  statementBalance Decimal              @map("statement_balance") @db.Decimal(18, 4)
  status           ReconciliationStatus @default(OPEN)
  createdById      String?              @map("created_by_id")
  createdAt        DateTime             @default(now()) @map("created_at")
  account          ChartOfAccount       @relation(fields: [accountId], references: [id])
  createdBy        User?                @relation("ReconciliationCreator", fields: [createdById], references: [id])
  lines            ReconciliationLine[]

  @@index([accountId, statementDate])
  @@map("reconciliations")
}

model ReconciliationLine {
  id                String          @id @default(cuid())
  reconciliationId  String          @map("reconciliation_id")
  bankTransactionId String          @map("bank_transaction_id")
  reconciliation    Reconciliation  @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)
  bankTransaction   BankTransaction @relation(fields: [bankTransactionId], references: [id])

  @@unique([reconciliationId, bankTransactionId])
  @@map("reconciliation_lines")
}

model FiscalPeriodCloseControl {
  id             String       @id @default(cuid())
  fiscalPeriodId String       @unique @map("fiscal_period_id")
  checklist      Json
  closedById     String?      @map("closed_by_id")
  closedAt       DateTime?    @map("closed_at")
  fiscalPeriod   FiscalPeriod @relation(fields: [fiscalPeriodId], references: [id], onDelete: Cascade)
  closedBy       User?        @relation("FiscalPeriodCloser", fields: [closedById], references: [id])

  @@map("fiscal_period_close_controls")
}

enum CashierSessionStatus {
  OPEN
  CLOSED
}

enum CashierTransactionType {
  CASH_IN
  CASH_OUT
  RECEIPT
  PAYMENT_VOUCHER
  REVERSAL
}

enum CashierTransactionStatus {
  POSTED
  REVERSED
}

enum CashierPaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  OTHER
}

enum CashierDocumentStatus {
  POSTED
  REVERSED
}

enum DailyCashierClosingStatus {
  OPEN
  COMPLETED
}

model CashierSession {
  id              String               @id @default(cuid())
  branchId        String               @map("branch_id")
  cashierId       String               @map("cashier_id")
  openingBalance  Decimal              @map("opening_balance") @db.Decimal(18, 4)
  closingBalance  Decimal?             @map("closing_balance") @db.Decimal(18, 4)
  expectedBalance Decimal?             @map("expected_balance") @db.Decimal(18, 4)
  status          CashierSessionStatus @default(OPEN)
  openedAt        DateTime             @default(now()) @map("opened_at")
  closedAt        DateTime?            @map("closed_at")
  branch          Branch               @relation(fields: [branchId], references: [id])
  cashier         User                 @relation("CashierUserSessions", fields: [cashierId], references: [id])
  transactions    CashierTransaction[]
  receipts        CashierReceipt[]
  vouchers        PaymentVoucher[]
  closing         DailyCashierClosing?

  @@index([cashierId, status])
  @@index([branchId, openedAt])
  @@map("cashier_sessions")
}

model CashierTransaction {
  id                    String                   @id @default(cuid())
  sessionId             String                   @map("session_id")
  actorId               String                   @map("actor_id")
  approvedById          String?                  @map("approved_by_id")
  originalTransactionId String?                  @map("original_transaction_id")
  journalEntryId        String?                  @map("journal_entry_id")
  type                  CashierTransactionType
  status                CashierTransactionStatus @default(POSTED)
  amount                Decimal                  @db.Decimal(18, 4)
  paymentMethod         CashierPaymentMethod     @map("payment_method")
  reason                String?                  @db.VarChar(500)
  sourceType            String?                  @map("source_type") @db.VarChar(80)
  sourceId              String?                  @map("source_id") @db.VarChar(120)
  createdAt             DateTime                 @default(now()) @map("created_at")
  session               CashierSession           @relation(fields: [sessionId], references: [id])
  actor                 User                     @relation("CashierTransactionActor", fields: [actorId], references: [id])
  approvedBy            User?                    @relation("CashierReversalApprover", fields: [approvedById], references: [id])
  originalTransaction   CashierTransaction?      @relation("CashierTransactionReversal", fields: [originalTransactionId], references: [id])
  reversals             CashierTransaction[]     @relation("CashierTransactionReversal")
  receipt               CashierReceipt?
  voucher               PaymentVoucher?

  @@index([sessionId, createdAt])
  @@index([sourceType, sourceId])
  @@map("cashier_transactions")
}

model CashierReceipt {
  id            String                @id @default(cuid())
  receiptNo     String                @unique @map("receipt_no") @db.VarChar(60)
  sessionId     String                @map("session_id")
  transactionId String                @unique @map("transaction_id")
  createdById   String                @map("created_by_id")
  customerId    String?               @map("customer_id")
  amount        Decimal               @db.Decimal(18, 4)
  paymentMethod CashierPaymentMethod  @map("payment_method")
  sourceType    String?               @map("source_type") @db.VarChar(80)
  sourceId      String?               @map("source_id") @db.VarChar(120)
  status        CashierDocumentStatus @default(POSTED)
  createdAt     DateTime              @default(now()) @map("created_at")
  session       CashierSession        @relation(fields: [sessionId], references: [id])
  transaction   CashierTransaction    @relation(fields: [transactionId], references: [id])
  createdBy     User                  @relation("CashierReceiptCreator", fields: [createdById], references: [id])
  customer      Customer?             @relation(fields: [customerId], references: [id])

  @@index([sessionId, createdAt])
  @@map("cashier_receipts")
}

model PaymentVoucher {
  id            String                @id @default(cuid())
  voucherNo     String                @unique @map("voucher_no") @db.VarChar(60)
  sessionId     String                @map("session_id")
  transactionId String                @unique @map("transaction_id")
  createdById   String                @map("created_by_id")
  payee         String                @db.VarChar(160)
  amount        Decimal               @db.Decimal(18, 4)
  paymentMethod CashierPaymentMethod  @map("payment_method")
  reason        String                @db.VarChar(500)
  sourceType    String?               @map("source_type") @db.VarChar(80)
  sourceId      String?               @map("source_id") @db.VarChar(120)
  status        CashierDocumentStatus @default(POSTED)
  createdAt     DateTime              @default(now()) @map("created_at")
  session       CashierSession        @relation(fields: [sessionId], references: [id])
  transaction   CashierTransaction    @relation(fields: [transactionId], references: [id])
  createdBy     User                  @relation("PaymentVoucherCreator", fields: [createdById], references: [id])

  @@index([sessionId, createdAt])
  @@map("payment_vouchers")
}

model DailyCashierClosing {
  id             String                    @id @default(cuid())
  sessionId      String                    @unique @map("session_id")
  branchId       String                    @map("branch_id")
  closingDate    DateTime                  @map("closing_date") @db.Date
  expectedAmount Decimal                   @map("expected_amount") @db.Decimal(18, 4)
  actualAmount   Decimal                   @map("actual_amount") @db.Decimal(18, 4)
  variance       Decimal                   @db.Decimal(18, 4)
  status         DailyCashierClosingStatus @default(COMPLETED)
  notes          String?                   @db.VarChar(500)
  createdById    String                    @map("created_by_id")
  createdAt      DateTime                  @default(now()) @map("created_at")
  session        CashierSession            @relation(fields: [sessionId], references: [id])
  branch         Branch                    @relation(fields: [branchId], references: [id])
  createdBy      User                      @relation("CashierClosingCreator", fields: [createdById], references: [id])

  @@index([branchId, closingDate])
  @@map("daily_cashier_closings")
}
